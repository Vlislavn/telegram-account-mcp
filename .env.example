# Create your own API app at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: keep all four tools inside these chats (numeric IDs, comma-separated).
# Unset = all chats this Telegram account can access. A blank value is rejected.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890

# Optional: sending is OFF by default. Enabling exposes telegram_send_message
# without a built-in human confirmation prompt; use your agent's permission gate.
# TELEGRAM_ENABLE_SEND=1

# Optional: override the private session location with an absolute .session path.
# TELEGRAM_SESSION_PATH=/absolute/path/to/account.session
